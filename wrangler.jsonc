{
  "name": "clone-wars-quotes",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["python_workers"],
  // Bundle non-Python files so Path(...).read_text() can find them
  "rules": [{ "type": "Data", "globs": ["data/*.json", "app/static/*.html"], "fallthrough": true }]
}